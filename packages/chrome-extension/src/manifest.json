{
  "manifest_version": 3,
  "name": "Annoncify - Multi-Platform Listing Manager",
  "version": "1.0.0",
  "description": "Automate creation, management, and messaging across Vinted, LeBonCoin, eBay, and more",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
 "content_scripts": [
  {
    "matches": ["*://*.vinted.fr/*", "*://*.vinted.com/*"],
    "js": ["content-vinted.js"],
    "run_at": "document_end"
  },
  {
    "matches": ["*://*.leboncoin.fr/*"],
    "js": ["content-leboncoin.js"],
    "run_at": "document_end"
  },
  {
    "matches": ["http://localhost:3000/*", "https://*.annoncify.com/*"],
    "js": ["content-bridge.js"],
    "run_at": "document_end"
  }
],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.com/*",
    "https://www.leboncoin.fr/*",
    "http://localhost:3000/*",
    "https://*.annoncify.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://*.annoncify.com/*"
    ]
  }
}
